<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập · WebChat</title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/auth.css" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
  </head>
  <body class="auth-page">
    <main class="auth-layout">
      <section class="auth-intro d-flex flex-column" aria-label="WebChat">
        <a class="auth-brand d-flex align-items-center" href="/login">
          <span class="auth-logo">
            <img src="/images/logo.png" alt="" width="44" height="44" />
          </span>
          <span>
            WebChat
            <small>Không gian trao đổi học tập</small>
          </span>
        </a>
        <div class="auth-welcome">
          <span class="auth-eyebrow">KẾT NỐI LỚP HỌC</span>
          <h2>
            Cùng học tập.
            <br />
            Cùng kết nối.
          </h2>
          <p>Trao đổi với giảng viên và bạn học trong không gian chung của lớp.</p>
          <div class="auth-feature d-flex align-items-center">
            <i class="bi bi-people" aria-hidden="true"></i>
            <span>Kết nối thành viên trong lớp</span>
          </div>
          <div class="auth-feature d-flex align-items-center">
            <i class="bi bi-chat-dots" aria-hidden="true"></i>
            <span>Trao đổi trong kênh chung của lớp</span>
          </div>
        </div>
        <small class="auth-intro-footer">WebChat · Trao đổi trong lớp học</small>
      </section>
      <section class="auth-form-panel d-flex flex-column justify-content-center" aria-labelledby="login-heading">
        <div class="auth-form-heading">
          <span class="eyebrow">CHÀO MỪNG TRỞ LẠI</span>
          <h1 id="login-heading">Đăng nhập</h1>
          <p>Sử dụng tài khoản của bạn để tiếp tục.</p>
        </div>
        <form action="/login" method="POST" class="auth-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger auth-error d-flex align-items-start" id="login-error" role="alert">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <span><%= error %></span>
          </div>
          <% } %>
          <div class="auth-field">
            <label for="username">Tên đăng nhập</label>
            <div class="auth-input">
              <span class="auth-input-icon"><i class="bi bi-person" aria-hidden="true"></i></span>
              <input class="form-control"
                id="username"
                name="username"
                type="text"
                placeholder="Nhập tên đăng nhập"
                autocomplete="username"
                autocapitalize="none"
                spellcheck="false"
                required
                <%= typeof error !== 'undefined' && error ? 'aria-describedby=login-error' : '' %>
              />
            </div>
          </div>
          <div class="auth-field">
            <label for="password">Mật khẩu</label>
            <div class="auth-input">
              <span class="auth-input-icon"><i class="bi bi-lock" aria-hidden="true"></i></span>
              <input class="form-control"
                id="password"
                name="password"
                type="password"
                placeholder="Nhập mật khẩu"
                autocomplete="current-password"
                required
                <%= typeof error !== 'undefined' && error ? 'aria-describedby=login-error' : '' %>
              />
              <button
                type="button"
                class="password-toggle"
                aria-label="Hiện mật khẩu"
                aria-controls="password"
                aria-pressed="false"
              >
                <span data-eye><i class="bi bi-eye" aria-hidden="true"></i></span>
                <span data-eye-slash hidden>
                  <i class="bi bi-eye-slash" aria-hidden="true"></i>
                </span>
              </button>
            </div>
          </div>
          <button type="submit" class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2 auth-submit w-100">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
            Đăng nhập
          </button>
          <p class="auth-help">Chưa có tài khoản? Liên hệ quản trị viên để được cấp.</p>
        </form>
      </section>
    </main>
    <script>
      // Hiện/ẩn mật khẩu và cập nhật nhãn, biểu tượng của nút.
      const toggle = document.querySelector(".password-toggle");
      const password = document.getElementById("password");
      toggle.addEventListener("click", () => {
        const show = password.type === "password";
        password.type = show ? "text" : "password";
        toggle.setAttribute("aria-pressed", String(show));
        toggle.setAttribute("aria-label", show ? "Ẩn mật khẩu" : "Hiện mật khẩu");
        toggle.querySelector("[data-eye]").hidden = show;
        toggle.querySelector("[data-eye-slash]").hidden = !show;
      });
    </script>
  </body>
</html>
