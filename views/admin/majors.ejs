<%- include('_start',{title:'Quản lý ngành',section:'majors',description:'Quản lý danh mục ngành thuộc từng khoa.'}) %>
<section class="panel card">
  <div class="panel-toolbar d-flex justify-content-between align-items-center gap-3">
    <div>
      <h2>Danh sách ngành</h2>
      <span class="muted">
        <%= majors.length %>
        kết quả
      </span>
    </div>
    <button class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2" data-open-dialog="create-dialog">
      <i class="bi bi-plus-lg" aria-hidden="true"></i>
      Thêm ngành
    </button>
  </div>
  <form method="GET" action="/admin/majors" class="filters d-flex align-items-end flex-wrap">
    <label class="filter-search">
      Tìm kiếm
      <input class="form-control" name="search" value="<%= filters.search || '' %>" placeholder="Tìm mã hoặc tên…" />
    </label>
    <label>
      Trạng thái
      <select class="form-select" name="status">
        <option value="">Tất cả</option>
        <option value="active" <%= filters.status==='active'?'selected':'' %>>Hoạt động</option>
        <option value="inactive" <%= filters.status==='inactive'?'selected':'' %>>Ngừng hoạt động</option>
      </select>
    </label>
    <button class="btn btn-light d-inline-flex align-items-center justify-content-center gap-2" type="submit">
      <i class="bi bi-funnel" aria-hidden="true"></i>
      Áp dụng
    </button>
    <a class="text-link" href="/admin/majors">
      <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
      Bỏ lọc
    </a>
  </form>
  <div class="table-wrap table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Mã</th>
          <th>Tên ngành</th>
          <th>Khoa</th>
          <th>Trạng thái</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if(!majors.length){ %>
        <tr><td colspan="5" class="empty text-center">Không có dữ liệu phù hợp.</td></tr>
        <% } majors.forEach(row=>{ %>
        <tr>
          <td class="code"><%= row.code %></td>
          <td>
            <strong><%= row.name %></strong>
          </td>
          <td><%= row.departmentId?.name || '—' %></td>
          <td>
            <span class="pill <%= row.status==='active'?'active':'closed' %> badge rounded-pill d-inline-flex align-items-center gap-2"><%= row.status==='active'?'Hoạt động':'Ngừng hoạt động' %></span>
          </td>
          <td>
            <div class="row-actions d-flex align-items-center">
              <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-2 btn-sm" data-open-dialog="edit-<%= row._id %>">
                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                Sửa
              </button>
              <form
                method="POST"
                action="/admin/majors/<%= row._id %>/toggle-status"
                data-confirm="Đổi trạng thái ngành? Kênh của ngành ngừng hoạt động sẽ được đóng."
              >
                <%- include('_csrf') %>
                <button class="btn btn-light d-inline-flex align-items-center justify-content-center gap-2 btn-sm">
                  <i class="bi bi-<%= row.status==='active'?'pause-circle':'play-circle' %>" aria-hidden="true"></i>
                  <%= row.status==='active'?'Ngừng hoạt động':'Kích hoạt' %>
                </button>
              </form>
            </div>
            <dialog id="edit-<%= row._id %>">
              <form action="/admin/majors/<%= row._id %>/update" method="POST" class="">
                <%- include('_csrf') %>
                <div class="dialog-heading d-flex justify-content-between align-items-center">
                  <h2>Sửa ngành</h2>
                  <button type="button" class="icon-button d-inline-flex align-items-center justify-content-center" data-close-dialog aria-label="Đóng">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                  </button>
                </div>
                <div class="form-grid">
                  <label>
                    Khoa
                    <select class="form-select" name="departmentId" required>
                      <option value="">Chọn khoa</option>
                      <% departments.forEach(d=>{const selected=row && String(row.departmentId?._id)===String(d._id); if(d.status==='active'||selected){ %>
                      <option value="<%= d._id %>" <%= selected?'selected':'' %>>
                        <%= d.code %>
                        —
                        <%= d.name %>
                      </option>
                      <% } }) %>
                    </select>
                  </label>
                  <label>
                    Mã ngành
                    <input class="form-control" name="code" maxlength="30" required value="<%= row.code %>" />
                  </label>
                  <label>
                    Tên ngành
                    <input class="form-control" name="name" maxlength="150" required value="<%= row.name %>" />
                  </label>
                </div>
                <div class="dialog-actions d-flex justify-content-end">
                  <button type="button" class="btn btn-light d-inline-flex align-items-center justify-content-center gap-2" data-close-dialog>
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                    Hủy
                  </button>
                  <button class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2" type="submit">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    Lưu thay đổi
                  </button>
                </div>
              </form>
            </dialog>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<dialog id="create-dialog">
  <form action="/admin/majors" method="POST" class="">
    <%- include('_csrf') %>
    <div class="dialog-heading d-flex justify-content-between align-items-center">
      <h2>Thêm ngành</h2>
      <button type="button" class="icon-button d-inline-flex align-items-center justify-content-center" data-close-dialog aria-label="Đóng">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
    </div>
    <div class="form-grid">
      <label>
        Khoa
        <select class="form-select" name="departmentId" required>
          <option value="">Chọn khoa</option>
          <% departments.filter(d=>d.status==='active').forEach(d=>{ %>
          <option value="<%= d._id %>">
            <%= d.code %>
            —
            <%= d.name %>
          </option>
          <% }) %>
        </select>
        <% if(!departments.some(d=>d.status==='active')){ %>
        <small>
          Chưa có khoa hoạt động.
          <a class="text-link" href="/admin/departments">Thêm hoặc kích hoạt khoa</a>
          trước khi tạo ngành.
        </small>
        <% } %>
      </label>

      <label>
        Mã ngành
        <input class="form-control" name="code" maxlength="30" required value="" />
      </label>
      <label>
        Tên ngành
        <input class="form-control" name="name" maxlength="150" required value="" />
      </label>
    </div>
    <div class="dialog-actions d-flex justify-content-end">
      <button type="button" class="btn btn-light d-inline-flex align-items-center justify-content-center gap-2" data-close-dialog>
        <i class="bi bi-x-lg" aria-hidden="true"></i>
        Hủy
      </button>
      <button class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2" type="submit">
        <i class="bi bi-check-lg" aria-hidden="true"></i>
        Lưu thay đổi
      </button>
    </div>
  </form>
</dialog>
<%- include('_end') %>
