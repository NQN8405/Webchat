<%- include('_start',{title:'Quản lý kênh chat',section:'channels',description:'Kênh chung của từng lớp. Đóng kênh luôn giữ lại lịch sử tin nhắn.'}) %>
<section class="panel card">
  <div class="panel-toolbar d-flex justify-content-between align-items-center gap-3">
    <div>
      <h2>Danh sách kênh</h2>
      <span class="muted">
        <%= channels.length %>
        kết quả · Tự tạo theo lớp
      </span>
    </div>
  </div>
  <form method="GET" action="/admin/channels" class="filters d-flex align-items-end flex-wrap">
    <label class="filter-search">
      Tìm kiếm
      <input class="form-control" name="search" value="<%= filters.search || '' %>" placeholder="Tìm mã hoặc tên…" />
    </label>
    <label>
      Không gian lớp
      <select class="form-select" name="classId">
        <option value="">Tất cả lớp</option>
        <% classes.forEach(s=>{ %>
        <option value="<%= s._id %>" <%= filters.classId===String(s._id)?'selected':'' %>>
          <%= s.code %>
          —
          <%= s.name %>
        </option>
        <% }) %>
      </select>
    </label>
    <label>
      Trạng thái
      <select class="form-select" name="status">
        <option value="">Tất cả</option>
        <option value="active" <%= filters.status==='active'?'selected':'' %>>Đang mở</option>
        <option value="closed" <%= filters.status==='closed'?'selected':'' %>>Đã đóng</option>
      </select>
    </label>
    <button class="btn btn-light d-inline-flex align-items-center justify-content-center gap-2" type="submit">
      <i class="bi bi-funnel" aria-hidden="true"></i>
      Áp dụng
    </button>
    <a class="text-link" href="/admin/channels">
      <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
      Bỏ lọc
    </a>
  </form>
  <div class="table-wrap table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Kênh</th>
          <th>Không gian lớp</th>
          <th>Thành viên</th>
          <th>Trạng thái</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if(!channels.length){ %>
        <tr>
          <td colspan="5" class="empty text-center">Chưa có kênh phù hợp. Tạo lớp để có kênh.</td>
        </tr>
        <% } channels.forEach(row=>{ %>
        <tr>
          <td>
            <strong><%= row.name %></strong>
            <small><%= 'Kênh chung' %></small>
          </td>
          <td><%= row.classId?.name || '—' %></td>
          <td>
            <%= countMap[String(row._id)] || 0 %>
            người
          </td>
          <td>
            <span class="pill <%= row.status==='active'?'active':'closed' %> badge rounded-pill d-inline-flex align-items-center gap-2"><%= row.status==='active'?'Đang mở':'Đã đóng' %></span>
          </td>
          <td>
            <div class="row-actions d-flex align-items-center">
              <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-2 btn-sm" data-open-dialog="edit-<%= row._id %>">
                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                Đổi tên
              </button>
              <form
                action="/admin/channels/<%= row._id %>/toggle-status"
                method="POST"
                data-confirm="Đổi trạng thái kênh? Lịch sử tin nhắn được giữ nguyên."
              >
                <%- include('_csrf') %>
                <button class="btn btn-light d-inline-flex align-items-center justify-content-center gap-2 btn-sm">
                  <i class="bi bi-<%= row.status==='active'?'stop-circle':'play-circle' %>" aria-hidden="true"></i>
                  <%= row.status==='active'?'Đóng kênh':'Mở lại' %>
                </button>
              </form>
            </div>
            <dialog id="edit-<%= row._id %>">
              <form action="/admin/channels/<%= row._id %>/update" method="POST" class="">
                <%- include('_csrf') %>
                <div class="dialog-heading d-flex justify-content-between align-items-center">
                  <h2>Đổi tên kênh</h2>
                  <button type="button" class="icon-button d-inline-flex align-items-center justify-content-center" data-close-dialog aria-label="Đóng">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                  </button>
                </div>
                <label>
                  Tên kênh
                  <input class="form-control" name="name" value="<%= row.name %>" required maxlength="150" />
                </label>
                <div class="dialog-actions d-flex justify-content-end">
                  <button type="button" class="btn btn-light d-inline-flex align-items-center justify-content-center gap-2" data-close-dialog>
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                    Hủy
                  </button>
                  <button class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2" type="submit">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    Lưu thay đổi
                  </button>
                </div>
              </form>
            </dialog>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('_end') %>
