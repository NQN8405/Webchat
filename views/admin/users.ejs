<%- include('_start',{title:'Quản lý tài khoản',section:'users',description:'Tạo tài khoản, phân quyền và quản lý khoa/lớp của người dùng.'}) %>
<section class="panel card">
  <div class="panel-toolbar d-flex justify-content-between align-items-center gap-3">
    <div>
      <h2>Danh sách tài khoản</h2>
      <span class="muted">
        <%= users.length %>
        kết quả
      </span>
    </div>
    <button class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2" data-open-dialog="create-dialog">
      <i class="bi bi-plus-lg" aria-hidden="true"></i>
      Thêm tài khoản
    </button>
  </div>
  <form method="GET" action="/admin/users" class="filters d-flex align-items-end flex-wrap">
    <label class="filter-search">
      Tìm kiếm
      <input class="form-control" name="search" value="<%= filters.search %>" placeholder="Tên hoặc tài khoản…" />
    </label>
    <label>
      Vai trò
      <select class="form-select" name="role">
        <option value="">Tất cả</option>
        <% [['student','Sinh viên'],['lecturer','Giảng viên'],['admin','Quản trị viên']].forEach(([v,l])=>{ %>
        <option value="<%= v %>" <%= filters.role===v?'selected':'' %>><%= l %></option>
        <% }) %>
      </select>
    </label>
    <label>
      Khoa
      <select class="form-select" name="departmentId">
        <option value="">Tất cả khoa</option>
        <% departments.forEach(d=>{ %>
        <option value="<%= d._id %>" <%= filters.departmentId===String(d._id)?'selected':'' %>><%= d.code %></option>
        <% }) %>
      </select>
    </label>
    <label>
      Lớp
      <select class="form-select" name="classId">
        <option value="">Tất cả lớp</option>
        <% classes.forEach(c=>{ %>
        <option value="<%= c._id %>" <%= filters.classId===String(c._id)?'selected':'' %>><%= c.code %></option>
        <% }) %>
      </select>
    </label>
    <label>
      Trạng thái
      <select class="form-select" name="status">
        <option value="">Tất cả</option>
        <option value="active" <%= filters.status==='active'?'selected':'' %>>Hoạt động</option>
        <option value="locked" <%= filters.status==='locked'?'selected':'' %>>Đã khóa</option>
      </select>
    </label>
    <button class="btn btn-light d-inline-flex align-items-center justify-content-center gap-2" type="submit">
      <i class="bi bi-funnel" aria-hidden="true"></i>
      Áp dụng
    </button>
    <a class="text-link" href="/admin/users">
      <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
      Bỏ lọc
    </a>
  </form>
  <div class="table-wrap table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Người dùng</th>
          <th>Ngày sinh</th>
          <th>Vai trò</th>
          <th>Khoa / Lớp</th>
          <th>Trạng thái</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if(!users.length){ %>
        <tr>
          <td colspan="6" class="empty text-center">
            Chưa có tài khoản phù hợp. Thử bỏ bộ lọc hoặc thêm tài khoản.
          </td>
        </tr>
        <% } users.forEach(row=>{ %>
        <tr>
          <td>
            <strong><%= row.displayName %></strong>
            <small><%= row.username %></small>
          </td>
          <td><%= row.birthDate ? new Date(row.birthDate).toLocaleDateString('vi-VN',{timeZone:'UTC'}) : 'Chưa cập nhật' %></td>
          <td><%= {student:'Sinh viên',lecturer:'Giảng viên',admin:'Quản trị viên'}[row.role] %></td>
          <td>
            <%= row.departmentId?.name || 'Chưa gán khoa' %>
            <small><%= row.classId?.code || 'Chưa xếp lớp' %></small>
          </td>
          <td>
            <span class="pill <%= row.status==='active'?'active':'closed' %> badge rounded-pill d-inline-flex align-items-center gap-2"><%= row.status==='active'?'Hoạt động':'Đã khóa' %></span>
          </td>
          <td>
            <div class="row-actions d-flex align-items-center">
              <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-2 btn-sm" data-open-dialog="edit-<%= row._id %>">
                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                Sửa
              </button>
              <% if(typeof user==='undefined'||user?.id!==String(row._id)){ %>
              <form
                action="/admin/users/<%= row._id %>/toggle-status"
                method="POST"
                data-confirm="Đổi trạng thái tài khoản này?"
              >
                <%- include('_csrf') %>
                <button class="btn btn-light d-inline-flex align-items-center justify-content-center gap-2 btn-sm">
                  <i class="bi bi-<%= row.status==='active'?'lock':'unlock' %>" aria-hidden="true"></i>
                  <%= row.status==='active'?'Khóa':'Mở khóa' %>
                </button>
              </form>
              <% } %>
            </div>
            <dialog id="edit-<%= row._id %>">
              <form action="/admin/users/<%= row._id %>/update" method="POST" class="membership-form">
                <%- include('_csrf') %>
                <div class="dialog-heading d-flex justify-content-between align-items-center">
                  <h2>Sửa tài khoản</h2>
                  <button type="button" class="icon-button d-inline-flex align-items-center justify-content-center" data-close-dialog aria-label="Đóng">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                  </button>
                </div>
                <%- include('_userFields',{record:row}) %>
                <div class="dialog-actions d-flex justify-content-end">
                  <button type="button" class="btn btn-light d-inline-flex align-items-center justify-content-center gap-2" data-close-dialog>
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                    Hủy
                  </button>
                  <button class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2" type="submit">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    Lưu thay đổi
                  </button>
                </div>
              </form>
            </dialog>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<dialog id="create-dialog">
  <form action="/admin/users" method="POST" class="membership-form">
    <%- include('_csrf') %>
    <div class="dialog-heading d-flex justify-content-between align-items-center">
      <h2>Thêm tài khoản</h2>
      <button type="button" class="icon-button d-inline-flex align-items-center justify-content-center" data-close-dialog aria-label="Đóng">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
    </div>
    <%- include('_userFields',{record:null}) %>
    <div class="dialog-actions d-flex justify-content-end">
      <button type="button" class="btn btn-light d-inline-flex align-items-center justify-content-center gap-2" data-close-dialog>
        <i class="bi bi-x-lg" aria-hidden="true"></i>
        Hủy
      </button>
      <button class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2" type="submit">
        <i class="bi bi-check-lg" aria-hidden="true"></i>
        Lưu thay đổi
      </button>
    </div>
  </form>
</dialog>
<%- include('_end') %>
